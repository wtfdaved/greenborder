<!-- Mobile Navigation -->
<nav class="tgb-mobile-nav">
  <a href="/" class="tgb-nav-item" id="nav-home">🏠 Home</a>
  <a href="/news.html" class="tgb-nav-item" id="nav-news">📰 News</a>
  <a href="/data.html" class="tgb-nav-item" id="nav-data">📊 Data</a>
  <a href="/#education" class="tgb-nav-item" id="nav-edu">📚 Education</a>
