</nav>

<script>
  // Set year in footer
  document.getElementById('tgb-year').textContent = new Date().getFullYear();

  // Header scroll effect
  window.addEventListener('scroll', () => {
    const header = document.getElementById('tgb-glass-header');
    header.classList.toggle('scrolled', window.scrollY > 100);
  });

  // Article filtering (for future use when more articles are added)
  function filterArticles(category) {
    const buttons = document.querySelectorAll('.category-filter');
    buttons.forEach(btn => btn.classList.remove('active'));
    event.target.classList.add('active');

    const articles = document.querySelectorAll('[data-category]');
    articles.forEach(article => {
      if (category === 'all' || article.dataset.category === category) {
        article.style.display = 'block';
      } else {
        article.style.display = 'none';
      }
    });
  }
</script>

</body>
</html>
