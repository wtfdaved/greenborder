  </div>

  <!-- Category Filters -->
  <div class="flex flex-wrap justify-center gap-3 mb-12">
    <button class="category-filter active" onclick="filterArticles('all')">All Articles</button>
    <button class="category-filter" onclick="filterArticles('policy')">Policy</button>
