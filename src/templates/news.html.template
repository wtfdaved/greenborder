        <div class="flex items-center gap-3 mb-4">
          <span class="tag" style="background:rgba(239,68,68,0.2);color:#f87171;border:1px solid rgba(239,68,68,0.3);">Featured</span>
          <span class="text-xs text-gray-500">March 5, 2026</span>
