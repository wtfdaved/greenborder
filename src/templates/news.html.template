<section class="px-4 max-w-6xl mx-auto mb-20">
  <div class="news-card rounded-2xl p-8 md:p-12" style="background:linear-gradient(135deg,rgba(16,185,129,0.07),rgba(245,158,11,0.04));border:1px solid rgba(16,185,129,0.2);">
