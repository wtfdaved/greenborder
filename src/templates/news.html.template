<!-- ╔══════════════════════════════════════════════╗ -->
<!-- ║          FEATURED ARTICLE                   ║ -->
<!-- ╚══════════════════════════════════════════════╝ -->
<section class="px-4 max-w-6xl mx-auto mb-16">
  <a href="/articles/hemp-ban-2026.html" class="news-card rounded-3xl overflow-hidden news-hero block no-underline transition hover:transform hover:translate-y-[-4px]">
